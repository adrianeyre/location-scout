# Location Scout's settings, for the backend, the frontend and the scripts.
# Copy to .env at the repo root and fill in what you need: cp .env.example .env
# pnpm dev, pnpm data:prepare, pnpm smoke, pnpm bench, pnpm survey and
# pnpm test:ai read it. Never commit .env.
# The values below run the app in development, on localhost.

# --- Backend (apps/api) ---

# Required by Nominatim's usage policy: identify your app and give a contact address.
# It is sent to Overpass too, which refuses requests that don't say who sends them.
# The API refuses to start without it.
NOMINATIM_USER_AGENT="location-scout-dev (you@example.com)"

# The port the backend listens on.
PORT=8787

# Optional: Planning Applications provider (planit by default; no key needed).
# planwire needs PLANWIRE_API_KEY too; without it the API says so as it starts
# and uses PlanIt. A free PlanWire key gives only samples, without their status.
PLANNING_APPLICATIONS_PROVIDER=planit
PLANWIRE_API_KEY=
# PlanIt asks for a User-Agent containing a contact email; without one,
# PlanIt is sent NOMINATIM_USER_AGENT, which has one too
PLANIT_USER_AGENT="location-scout-dev (you@example.com)"

# Optional: EPC ratings and price per m² in the Property Layer (off when unset).
# The bearer token from your account page at
# get-energy-performance-data.communities.gov.uk (sign in with GOV.UK One Login)
EPC_API_KEY=

# Optional: AI Explanations (off when unset). Your own key from the Claude
# Console, and the model, claude-sonnet-5-5 unless set.
# pnpm test:ai and pnpm smoke use them too.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: Google Street View (off when unset). A browser key for Google's
# Maps JavaScript API, restricted to http://localhost:5173/* and that API.
GOOGLE_MAPS_API_KEY=

# --- Scripts ---

# Optional: HM Land Registry data service key, for CCOD/OCOD downloads in
# pnpm data:prepare (Ownership Categories are skipped when unset)
LAND_REGISTRY_DATA_API_KEY=

# --- Frontend (apps/web) ---

# Where the dev server sends /api requests: the backend, on PORT above.
API_ORIGIN=http://localhost:8787
# The address the site is served from, for link previews, robots.txt and
# sitemap.xml. Set it to the real address when building for anywhere else.
SITE_URL=http://localhost:5173
