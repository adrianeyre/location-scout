{
  "name": "@location-scout/api",
  "version": "0.0.0",
  "private": true,
  "description": "Location Scout's local backend: the only thing that calls Data Sources.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "start:fixtures": "tsx src/testing/fixture-server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fixture:record": "tsx src/testing/record-fixture.ts",
    "test:ai": "tsx --env-file-if-exists=../../.env src/explain/test-ai.ts",
    "smoke": "tsx --env-file-if-exists=../../.env src/smoke/smoke.ts",
    "bench": "tsx --env-file-if-exists=../../.env src/bench/bench.ts",
    "survey": "tsx --env-file-if-exists=../../.env src/survey/survey.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@duckdb/node-api": "1.5.6-r.1",
    "@hono/node-server": "^2.1.5",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "@location-scout/shared": "workspace:*",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "vitest": "^5.0.4"
  }
}
