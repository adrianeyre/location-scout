{
  "name": "@location-scout/web",
  "version": "0.0.0",
  "private": true,
  "description": "Location Scout's frontend. It talks only to our own backend under /api.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "brand:assets": "tsx scripts/generate-brand-assets.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@location-scout/shared": "workspace:*",
    "maplibre-gl": "^6.14.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "supercluster": "^9.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
