{
  // Type-checks the website's own scripts: build.ts and vite.config.ts,
  // which run in Node, and script.mts, which runs in the browser. The
  // illustrations have demos/tsconfig.json.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"]
  },
  "include": ["build.ts", "vite.config.ts", "script.mts"]
}
